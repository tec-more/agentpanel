{
    "name": "harness",
    "display_name": "Harness 接入",
    "version": "0.1.0",
    "description": "DeepSeek Harness 业务接入：客户端凭据、身份映射、会话/运行生命周期、步骤与用量回传、安全审计、动作策略、模型价格",
    "author": "agentpanel",
    "is_installed": true,
    "is_enabled": true,
    "route_prefix": "/v1/harness",
    "routes": [
        "api/v1"
    ],
    "internal_routes": [
        "api/app_internal"
    ],
    "models": [],
    "schemas": [
        "harness"
    ],
    "menus": [],
    "permissions": [
        {
            "name": "Harness 客户端管理",
            "code": "harness:client:manage",
            "module": "harness",
            "description": "签发/吊销 Harness 客户端凭据"
        },
        {
            "name": "Harness 身份映射管理",
            "code": "harness:identity:manage",
            "module": "harness",
            "description": "绑定/禁用外部身份到本地用户"
        },
        {
            "name": "Harness 会话与运行查看",
            "code": "harness:run:view",
            "module": "harness",
            "description": "查看 Harness 会话、运行与步骤"
        },
        {
            "name": "Harness 审计查看",
            "code": "harness:audit:view",
            "module": "harness",
            "description": "查看 Harness 安全审计事件"
        },
        {
            "name": "Harness 动作策略管理",
            "code": "harness:policy:manage",
            "module": "harness",
            "description": "管理高危动作安全策略"
        },
        {
            "name": "Harness 模型价格管理",
            "code": "harness:price:manage",
            "module": "harness",
            "description": "管理模型价格版本"
        }
    ],
    "dependencies": [],
    "hooks": {},
    "config": {
        "hold_ttl_seconds": 3600,
        "fail_closed": true,
        "lock_runtime_version": "0.1.5rc1",
        "session_format": "auto",
        "session_format_source": "header.version",
        "session_format_supported": [
            "v3",
            "v4"
        ],
        "model_credential": {
            "provider": null,
            "model": null
        },
        "runtime": {
            "dsh_command": null,
            "dsh_command_mode": "sdk_runtime",
            "dsh_home": ".dsh",
            "env_names": {
                "api_key": "DEEPSEEK_API_KEY",
                "base_url": "DEEPSEEK_BASE_URL",
                "provider": "DSH_PROVIDER",
                "model": "DSH_MODEL"
            },
            "allow_env_fallback": false,
            "allow_direct_provider": false
        },
        "gateway_issuance": {
            "enabled": true,
            "deployment": "standalone",
            "public_base_url": "http://127.0.0.1:9999",
            "health_check_timeout_seconds": 3,
            "lease_ttl_seconds": 900,
            "renew_ttl_seconds": 900,
            "max_lease_ttl_seconds": 3600,
            "tenant_lease_ttl_seconds": {},
            "max_rpm": 60,
            "provider_domain_allowlist": [
                "api.deepseek.com"
            ],
            "allow_loopback": false,
            "reconciliation": {
                "enabled": true,
                "interval_seconds": 600,
                "window_hours": 24,
                "max_window_hours": 168,
                "diff_amount_high": 1000.0,
                "diff_rate_high": 0.1,
                "diff_cost_high": 1.0,
                "missing_amount_high": 1000.0,
                "duplicate_ratio_high": 2.0
            }
        },
        "egress": {
            "version": 1,
            "min_supported_version": 1,
            "allow_client_non_gateway": false,
            "tool_denylist": [
                "web_fetch",
                "web_search",
                "browser",
                "http_request"
            ],
            "snapshot_ttl_seconds": 300
        },
        "approval": {
            "interception": "backend_api",
            "timeout_seconds": 300,
            "default_scope": "once",
            "allowed_scopes": [
                "once",
                "session_pattern"
            ],
            "admin_fallback_risk": [
                "high",
                "critical"
            ],
            "ruleset_version": 1,
            "fail_closed": true,
            "degrade_to_danger_full_access": false
        }
    }
}