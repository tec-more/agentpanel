# docker-compose 环境变量模板（cp .env.example .env 后由 prepare-secrets.ps1 覆写；.env 严禁提交仓库）

# 数据库名 / 用户（与 config.conf [db] 一致；密码走 secrets，不在此出现）
DB_NAME=agentpanel
DB_USER=admin

# agentpanel-app 镜像 tag（与 deploy/app 构建的 tag 保持一致；默认 latest）
TAG=latest

# taskiq 专用 RabbitMQ vhost（与 config.conf [rabbitmq] taskiq_vhost 一致）
TASKIQ_VHOST=agentpanel
