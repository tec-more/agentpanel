# Copy to production.env in the same machine configuration directory and fill in the values.
DSH_DESKTOP_APP_ID=com.deepseek.dsh
DSH_DESKTOP_AUTO_UPDATE_ENV=production
DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{}'
# DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
# Installer archive compression (0-9).
DSH_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3

# ---- agentpanel 客户账号认证（customer 主体 + 邮箱验证码注册）----
# 桌面端用邮箱验证码注册 / 邮箱密码登录，拿到 typ=cus 的 JWT 后向控制面换取
# 绑定 cus 主体的网关租约虚拟 key（dgw.*）；网关数据面不接受 JWT。
AGENTPANEL_GATEWAY_URL=http://127.0.0.1:9999
# 控制面客户体系基址（/v1/customer/auth/* 与 /v1/customer/leases），默认 9998
AGENTPANEL_CUSTOMER_URL=http://127.0.0.1:9998/v1/customer
# AGENTPANEL_ACCOUNT_STORE_DIR=
